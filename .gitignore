# Never commit credentials
*.pem
*.key
.env
.env.*

# Cisco documentation (not redistributable): keep it local
Supported_Metrices.md
cisco-docs/

# Zabbix documentation PDF (about 50 MB, reference only): keep it local
docs/Zabbix_Documentation_*.pdf

# Parameters of local zabbix_js runs: they contain the private key
params.json

# Editors / OS
# .vscode/ stays local, except extensions.json: the folder must exist because the dev container
# mounts it read-only (.devcontainer/devcontainer.json).
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
__pycache__/

# Commit message written by Claude Code for the user (see CLAUDE.md, "Change workflow")
.commit-msg.txt

# Personal Claude Code approvals ("don't ask again"): never shared
.claude/settings.local.json
